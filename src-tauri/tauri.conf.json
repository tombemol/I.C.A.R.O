{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "I.C.A.R.O.",
  "version": "0.0.1",
  "identifier": "dev.tombemol.icaro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "I.C.A.R.O.",
        "width": 420,
        "height": 860,
        "minWidth": 320,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
